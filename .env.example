# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs of admins (e.g. 123456789,987654321)
ADMIN_IDS=

# ── Encryption ──────────────────────────────────────────────────────────────
# Fernet symmetric key for encrypting IQ Option credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all stored credentials permanently unrecoverable.
FERNET_KEY=

# ── IQ Option ───────────────────────────────────────────────────────────────
# SSID used by the bias engine (a dedicated IQ Option account, not a user's)
BIAS_ENGINE_SSID=

# IQ Option platform ID (9 for standard)
PLATFORM_ID=9

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Database ─────────────────────────────────────────────────────────────────
IQBOT_DB_PATH=/var/lib/iqbot/iqbot.db

# ── Affiliate ────────────────────────────────────────────────────────────────
# Your IQ Option affiliate link shown to unverified users
AFFILIATE_LINK=https://iqoption.com/?aff=YOUR_ID

# Telegram channel ID where affiliate sign-up events are posted
AFFILIATE_CHANNEL_ID=

# ── Funnel webhook ───────────────────────────────────────────────────────────
# Secret used to verify HMAC-SHA256 signatures on incoming webhook POST requests.
# Set the same value in your landing page and in this env var.
# Leave empty to disable signature verification (not recommended for production).
LANDING_WEBHOOK_SECRET=

# ── Quadcode OAuth 2.0 (optional — enables secure broker-level OAuth connect) ─
# Register an OAuth application in the Quadcode / IQ Option partner portal to
# obtain OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET.
#
# How the flow works:
#   1. User types /addaccount in Telegram
#   2. Bot generates a PKCE code_challenge and sends an IQ Option authorise URL
#   3. User clicks the link, logs in on IQ Option, and is redirected to
#      OAUTH_REDIRECT_URI with an authorisation code
#   4. Bot exchanges the code for an SSID (access_token) + refresh_token
#   5. SSID is used for WebSocket auth; refresh_token gets new SSIDs silently
#
# OAUTH_REDIRECT_URI must be publicly reachable and point to port 8090 of
# this server, e.g. https://yourbot.example.com/oauth/callback
#
# Leave all three blank to use the legacy email/password flow instead.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Override if using a non-IQ-Option Quadcode broker (defaults to auth.iqoption.com)
# OAUTH_BASE_URL=https://auth.iqoption.com
